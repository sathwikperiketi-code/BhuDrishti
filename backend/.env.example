BHUDRISHTI_ENVIRONMENT=
# Omit DATABASE_URL to use the stable backend/bhudrishti.db local default.
# Set BHUDRISHTI_DATABASE_URL only when connecting to a different database.
BHUDRISHTI_DATABASE_URL=
BHUDRISHTI_AUTH_SECRET=
BHUDRISHTI_CORS_ORIGINS=
# Frontend URL is shared in the repository-root .env.
# See ../.env.example: VITE_APP_URL
# Set all six values below in an ignored backend/.env using the SMTP
# provider's documented settings. Do not put real credentials in this example.
# SMTP_SECURE=true selects implicit TLS; false requires STARTTLS.
# The app does not send account email until SMTP_HOST and SMTP_FROM are set.
# This example lists names only. Fill required values and remove unset optional
# entries before starting; empty optional numeric/JSON values are not defaults.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
BHUDRISHTI_FIELD_SCORE_WEIGHT=
BHUDRISHTI_RECORD_SCORE_WEIGHT=
BHUDRISHTI_CROSS_SYSTEM_SCORE_WEIGHT=
BHUDRISHTI_REJECT_THRESHOLD=
BHUDRISHTI_APPROVE_THRESHOLD=
